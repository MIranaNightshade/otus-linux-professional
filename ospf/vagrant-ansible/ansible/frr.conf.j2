frr version 10.7.1
frr defaults traditional
hostname router3
log syslog informational
service integrated-vtysh-config
!
interface eth1
 no ip ospf passive
exit
!
interface eth2
 {% if ansible_hostname == 'router1' %}
 ip ospf cost 1000
{% elif ansible_hostname == 'router3' and symmetric_routing == true %}
 ip ospf cost 1000
{% endif %}
 no ip ospf passive
exit
!
interface lo0
 ip address {{ router_id }}
exit
!
router ospf
 ospf router-id {{ router_id }}
 passive-interface default
 network {{ network1 }} area 0
 network {{ network2 }} area 0
 network {{ network3 }} area 0
exit
!
